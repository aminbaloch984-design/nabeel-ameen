# ==========================================================================
# NEW AI — local backend configuration
# Copy this file to server/.env and fill in real values.
# Never commit server/.env.
# ==========================================================================

# Local web server
PORT=8787
# Keep 127.0.0.1 for local-only access. Use 0.0.0.0 only on a trusted LAN.
HOST=127.0.0.1

# OpenAI-compatible provider base URL (no trailing slash, no /chat/completions)
# OpenAI:      https://api.openai.com/v1
# Google AI Studio (Gemini): https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# Ollama:      http://127.0.0.1:11434/v1
PROVIDER_BASE_URL=https://api.openai.com/v1

# Provider secret. Stays on this machine; never sent to the browser.
API_KEY=replace-with-your-key

# Model used by the health check and as a fallback. The UI can override it.
DEFAULT_MODEL=gpt-4o-mini

# Optional: comma-separated models the browser may switch to when the default
# model is rate-limited (HTTP 429) or temporarily unavailable (503).
# Leave empty to disable fallback. Example for Google AI Studio:
# FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
FALLBACK_MODELS=

# Local models (Ollama) do not need a key. Set true only for a trusted local
# provider. Keep false for cloud APIs.
ALLOW_NO_KEY=false

# Optional: allow a specific dev origin (comma separated). Needed only when
# the page is served from a different origin, e.g. VS Code Live Server.
# ALLOWED_ORIGIN=http://localhost:5500
# Use * only for local development, never on a public host.
# ALLOWED_ORIGIN=*

# Public deployments: require this bearer token on /api/chat so strangers who
# find the URL cannot spend your provider quota. The browser sends it from
# Settings → Access token. Leave empty for local-only use.
# AUTH_TOKEN=long-random-string

# Upstream timeout in milliseconds.
REQUEST_TIMEOUT_MS=120000
